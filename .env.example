# Скопируйте в .env (локально) или впишите на Render → Environment.
# Обязательные помечены (!).

# (!) Токен бота от @BotFather
BOT_TOKEN=1234567890:AA...
# (!) Строка подключения к PostgreSQL (Neon: Dashboard → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# (!) Секрет вебхука Telegram — любые латинские буквы и цифры, 20+ символов
WEBHOOK_SECRET=change_me_random_letters_and_digits
# (!) Ключ для /tick — тот же вписать в GitHub → Settings → Secrets → TICK_URL
TICK_KEY=change_me_another_random_string
# Адрес сервиса. На Render задавать НЕ нужно (берётся из RENDER_EXTERNAL_URL)
BASE_URL=
# (!) Ваш Telegram ID (узнать у @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789
# Ваше имя в приветствии
COACH_NAME=Айгерим

# Часовой пояс по умолчанию и часы отправки (по времени участницы)
DEFAULT_TZ=Asia/Almaty
DAY_HOUR=11
EVENING_HOUR=19
INFO_HOUR=13
NUDGE_HOUR=17
CHECKIN_HOUR=20
QUIET_HOUR=22
# Видео дня не загружено — ждём до этого часа, потом «день отдыха»
MISSING_HOUR=21
# Когда напоминать вам о незагруженных тренировках (по DEFAULT_TZ)
ADMIN_MORNING_HOUR=9
ADMIN_EVENING_HOUR=20

# Закрытый женский чат бесплатной недели (обычная ссылка-приглашение)
FREE_CHAT_LINK=https://t.me/+xxxxxxxxxxxx
# ID платного канала/чата клуба (бот должен быть там админом с правом приглашать)
CLUB_CHAT_ID=-1001234567890
# Отдельный канал для тарифа «каждый день» (пусто — оба тарифа в CLUB_CHAT_ID)
CLUB_CHAT_ID_6X=

# Тарифы клуба на месяц (как показать цену участнице)
PRICE_3X=2 500 ₽
PRICE_6X=5 000 ₽

# Tribute: ссылки на подписку каждого тарифа
TRIBUTE_LINK_3X=https://t.me/tribute/app?startapp=sXXXX
TRIBUTE_LINK_6X=https://t.me/tribute/app?startapp=sYYYY
# ID товаров/подписок Tribute каждого тарифа (видны в логе Render после оплаты)
TRIBUTE_PRODUCT_IDS_3X=
TRIBUTE_PRODUCT_IDS_6X=
# API-ключ Tribute (для проверки подписи вебхука). Пусто — вебхук не принимается
TRIBUTE_API_KEY=

# Запасная оплата звёздами Telegram (0 — кнопка скрыта)
STARS_PRICE_3X=0
STARS_PRICE_6X=0

# Лимит рассылки, сообщений в секунду
SEND_RATE=25
